<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/144.0.0.0 Safari/537.36" version="29.3.4">
  <diagram name="Page-1" id="7NQhVqVYZA_9ouIxY9PE">
    <mxGraphModel dx="1737" dy="947" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam classAttributeIconSize 0\n\ninterface FileSystemComponent {\n    + showDetails() : void\n}\n\nclass File {\n    - name : String\n    + File(name: String)\n    + showDetails() : void\n}\n\nclass Folder {\n    - name : String\n    - children : List&lt;FileSystemComponent&gt;\n    + Folder(name: String)\n    + add(component: FileSystemComponent) : void\n    + remove(component: FileSystemComponent) : void\n    + showDetails() : void\n}\n\nFileSystemComponent &lt;|.. File\nFileSystemComponent &lt;|.. Folder\nFolder o--&gt; FileSystemComponent : contains\n\n\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="RWL_dyQppxB04oHM03h1-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="289" width="541" x="70" y="70" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam classAttributeIconSize 0\n\ninterface IJsonService {\n    + processJsonData() : void\n}\n\nclass XmlLibrary {\n    + getXmlData() : String\n}\n\nclass XmlToJsonAdapter {\n    - xmlLibrary : XmlLibrary\n    + XmlToJsonAdapter(xmlLibrary: XmlLibrary)\n    + processJsonData() : void\n}\n\nIJsonService &lt;|.. XmlToJsonAdapter\nXmlToJsonAdapter --&gt; XmlLibrary : adapts\n\n\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="RWL_dyQppxB04oHM03h1-2">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="368" width="313" x="100" y="570" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\ninterface Observer {\n    + update(message: String) : void\n}\n\ninterface Subject {\n    + attach(observer: Observer) : void\n    + detach(observer: Observer) : void\n    + notifyObservers() : void\n}\n\nclass Stock {\n    - symbol : String\n    - price : float\n    - observers : List&lt;Observer&gt;\n    + setPrice(price: float) : void\n    + notifyObservers() : void\n}\n\nclass Investor {\n    - name : String\n    + update(message: String) : void\n}\n\nSubject &lt;|.. Stock\nObserver &lt;|.. Investor\nStock o--&gt; Observer : notifies\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="RWL_dyQppxB04oHM03h1-3">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="567" width="264" x="760" y="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\n\n&#39; --- 1. Singleton ---\nclass Library {\n    - {static} instance : Library\n    - books : List&lt;Book&gt;\n    - observers : List&lt;Observer&gt;\n    - Library()\n    + {static} getInstance() : Library\n    &#39; Bổ sung nghiệp vụ\n    + addBook(book: Book) : void\n    + removeBook(book: Book) : void\n    + borrowBook(user: User, book: Book) : void\n    + returnBook(user: User, book: Book) : void\n    + search(strategy: SearchStrategy, keyword: String) : void\n    &#39; Observer methods\n    + attach(o: Observer) : void\n    + detach(o: Observer) : void\n    + notifyObservers(msg: String) : void\n}\n\n&#39; --- 2. Factory Method (Simple Factory) ---\nabstract class Book {\n    # title : String\n    # author : String\n    # category : String\n    + Book(title: String, author: String, category: String)\n    + getDetails() : String\n    + getTitle() : String\n    + getCategory() : String\n    + getAuthor() : String\n}\n\nclass PaperBook extends Book {\n    + getDetails() : String\n}\nclass EBook extends Book {\n    + getDetails() : String\n}\n\nclass BookFactory {\n    + {static} createBook(type: String, title: String, author: String, category: String) : Book\n}\n\n&#39; --- 3. Strategy ---\ninterface SearchStrategy {\n    + search(books: List&lt;Book&gt;, keyword: String) : void\n}\n\nclass NameSearchStrategy implements SearchStrategy\nclass AuthorSearchStrategy implements SearchStrategy\n&#39; Bổ sung tìm theo thể loại\nclass CategorySearchStrategy implements SearchStrategy \n\n&#39; --- 4. Observer ---\ninterface Observer {\n    + update(message: String) : void\n}\nclass User implements Observer {\n    - name : String\n    + User(name: String)\n    + update(message: String) : void\n}\n\n&#39; --- 5. Decorator ---\nabstract class BookDecorator extends Book {\n    # wrappedBook : Book\n    + BookDecorator(book: Book)\n    + getDetails() : String\n}\n\nclass SpecialEditionDecorator extends BookDecorator {\n    + SpecialEditionDecorator(book: Book)\n    + getDetails() : String\n}\n\nclass TranslatedEditionDecorator extends BookDecorator {\n    + TranslatedEditionDecorator(book: Book)\n    + getDetails() : String\n}\n\n&#39; --- Relationships ---\nLibrary \&quot;1\&quot; *-- \&quot;*\&quot; Book : manages &gt;\nLibrary o-- \&quot;*\&quot; Observer : notifies &gt;\nLibrary ..&gt; SearchStrategy : uses &gt;\nBookFactory ..&gt; Book : creates &gt;\nBookDecorator o-- \&quot;1\&quot; Book : decorates &gt;\n\n\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="RWL_dyQppxB04oHM03h1-4">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="775" width="1525" x="120" y="990" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
