<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36" version="29.6.1" pages="2">
  <diagram name="Page-1" id="M1LPxtVO73WxJc14eOy-">
    <mxGraphModel dx="1389" dy="757" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n!theme plain\nskinparam componentStyle rectangle\nskinparam backgroundColor white\nskinparam padding 5\n\nactor \&quot;Client\\n(Web/Mobile)\&quot; as User\n\nrectangle {\n  component \&quot;API Gateway\&quot; as Gateway\n\n  rectangle \&quot;Service\&quot; {\n    [User Service] as US\n    [Restaurant Service] as RS\n    [Order Service] as OS\n    [Payment Service] as PS\n    [Delivery Service] as DS\n  }\n\n  queue \&quot;Message Broker\\n(Kafka / RabbitMQ)\&quot; as Kafka\n\n \n    database \&quot;User DB\&quot; as UDB\n    database \&quot;Catalog DB\\n(Mongo)\&quot; as RDB\n    database \&quot;Order DB\&quot; as ODB\n    database \&quot;Payment DB\&quot; as PDB\n    database \&quot;Tracking DB\\n(Redis)\&quot; as DDB\n \n}\n\n&#39; Luồng Sync\nUser ==&gt; Gateway : REST / gRPC\nGateway --&gt; US : Sync\nGateway --&gt; RS : Sync\nGateway --&gt; OS : Sync\nGateway --&gt; PS : Sync\nGateway --&gt; DS : Sync\n\n&#39; Kết nối DB riêng\nUS --&gt; UDB\nRS --&gt; RDB\nOS --&gt; ODB\nPS --&gt; PDB\nDS --&gt; DDB\n\n&#39; Luồng Async qua Kafka\nOS =down=&gt; Kafka : Publish\\n(OrderCreatedEvent)\nKafka =up=&gt; PS : Subscribe\nKafka =up=&gt; RS : Subscribe\nKafka =up=&gt; DS : Subscribe\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="vt2Rs3iMdlBqsIn_1IBR-2">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="607" width="907" x="40" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="Ss-uqZPzhaDOmXBifEGA" name="Page-2">
    <mxGraphModel dx="1097" dy="598" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n!theme plain\nskinparam linetype ortho\nskinparam padding 5\nskinparam NodePadding 10\nskinparam shadowing false\nskinparam monochrome true\n\nrectangle \&quot;Client\\n(Web / Mobile App)\&quot; as Client\n\nrectangle {\n  \n  rectangle \&quot;Presentation Layer (API / Controllers)\&quot; {\n    rectangle \&quot;Mobile API Gateway\&quot; as MobileAPI\n    rectangle \&quot;Web Admin Controllers\&quot; as WebAPI\n  }\n\n  rectangle \&quot;Business Logic Layer (Services)\&quot; {\n    rectangle \&quot;Order Module\&quot; as OS\n    rectangle \&quot;User Module\&quot; as US\n    rectangle \&quot;Restaurant Module\&quot; as RS\n    rectangle \&quot;Payment Module\&quot; as PS\n    rectangle \&quot;Delivery Module\&quot; as DS\n  }\n\n  rectangle \&quot;Persistence (Repositories)\&quot; {\n    rectangle \&quot;Data Access Objects (DAO) / ORM\&quot; as Repos\n  }\n}\n\nrectangle \&quot;Database\&quot; as DB\n\n&#39; Luồng gọi từ ngoài vào\nClient =down=&gt; MobileAPI : REST / JSON\nClient =down=&gt; WebAPI : HTTP\n\n&#39; Tầng UI gọi xuống Tầng Business\nMobileAPI =down=&gt; OS\nMobileAPI =down=&gt; US\nWebAPI =down=&gt; RS\n\n&#39; Tầng Business gọi xuống Tầng Data\nOS =down=&gt; Repos\nUS =down=&gt; Repos\nRS =down=&gt; Repos\nPS =down=&gt; Repos\nDS =down=&gt; Repos\n\n&#39; Tầng Data gọi xuống Database\nRepos =down=&gt; DB : SQL Queries\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="TsV8gVcNdIcUw-XU6jAY-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="579" width="873" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
